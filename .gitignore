# Environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Atomic-write temporaries (they should never survive a turn)
*.json.tmp

# The REAL configuration is not versioned: it lives outside the repo, in the OS
# per-user config (see README, "Why the config lives outside the repo"). The repo
# only carries config/proyectos.ejemplo.json. This line is an extra belt in case
# someone creates the file inside the repo by hand.
config/proyectos.json

# The report archive is NOT versioned and does not live here: it goes to a root
# outside any git repository. This line is the second belt, in case one day
# raiz_informes points inside again: the reports carry the full text of work
# sessions.
informes/

# The hook's log is a runtime artifact, like the config: it is generated on run,
# changes on every machine, and has no business in a public repo. Its real place
# is the sibling of the archive (outside git); this line covers the case where it
# is generated here by falling back to the default config.
informes.log
